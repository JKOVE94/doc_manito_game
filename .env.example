# Supabase — Project Settings > API Keys ("Publishable and secret API keys" 탭)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# publishable key (sb_publishable_…) — 브라우저 노출 안전. Realtime 변경 신호 구독 전용 (RLS 로 game_sessions 만 읽힘)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret key (sb_secret_…) — 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=

# --- 레거시 키를 쓰는 경우 (위 두 개 대신 사용 가능) ---
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 쿠키 서명 키, 16자 이상 (openssl rand -base64 32)
SESSION_SECRET=
# 호스트 콘솔 비밀번호
ADMIN_PASSWORD=

# Gemini (AI 스무고개 힌트). 비워두면 기능 비활성화
GEMINI_API_KEY=
# 선택: 기본 gemini-3.8-flash
GEMINI_MODEL=
