# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon / publishable key — Realtime 변경 신호 구독 전용 (RLS 로 game_sessions 만 읽힘)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 쿠키 서명 키 (openssl rand -base64 32)
SESSION_SECRET=
# 호스트 콘솔 비밀번호
ADMIN_PASSWORD=

# Gemini (AI 스무고개 힌트). 비워두면 기능 비활성화
GEMINI_API_KEY=
# 선택: 기본 gemini-3.8-flash
GEMINI_MODEL=
